# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit actual keys to version control
# Get these from: https://app.supabase.com/project/_/settings/api

# Replace with your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Replace with the ANON (public) key from Supabase Dashboard
# This is a PUBLIC key - safe to expose in frontend bundle
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# AI COACH (Optional - requires API keys)
# ===========================================

# Local AI Coach server (development only)
VITE_API_BASE_URL=http://localhost:3001

# AI provider API key (server-side only - NEVER expose to frontend)
AI_API_KEY=your-openai-compatible-api-key
AI_MODEL=gpt-4o-mini

# Claude API key for Vercel/serverless deployment (server-side only)
CLAUDE_API_KEY=your-claude-api-key

# OpenAI API key for RAG embeddings (server-side only)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
