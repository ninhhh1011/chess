# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project details
# Get these from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional local AI Coach server
VITE_API_BASE_URL=http://localhost:3001
AI_API_KEY=your-openai-compatible-api-key
AI_MODEL=gpt-4o-mini

# Optional Vercel/serverless AI Coach path
CLAUDE_API_KEY=your-claude-api-key

# OpenAI API key for RAG embeddings (text-embedding-3-small)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
