    "autoprefixer": "10.5.0",
    "chess.js": "1.4.0",
    "clsx": "^2.1.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "postcss": "8.5.12",
    "react": "19.2.5",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-chessboard": "5.10.0",
